
{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}

    <div class="container mt-5">

        <h1>Liste des catégories</h1>

        <a
            href="{{ path('app_categorie_ajouter') }}"
            class="btn btn-primary mb-3"
        >
            Ajouter une catégorie
        </a>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for categorie in categories %}
                    <tr>
                        <td>{{ categorie.id }}</td>
                        <td>{{ categorie.nom }}</td>
                        <td>{{ categorie.description }}</td>

                        <td>
                            <a
                                href="{{ path('app_categorie_modifier', {'id': categorie.id}) }}"
                                class="btn btn-warning"
                            >
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_categorie_supprimer', {'id': categorie.id}) }}"
                                style="display:inline-block"
                                onsubmit="return confirm('Voulez-vous supprimer cette catégorie ?');"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('supprimer' ~ categorie.id) }}"
                                >

                                <button class="btn btn-danger">
                                    Supprimer
                                </button>

                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">
                            Aucune catégorie disponible.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>

        </table>

    </div>

{% endblock %}
