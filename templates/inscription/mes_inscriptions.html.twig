{% extends 'base.html.twig' %}

{% block title %}Mes inscriptions{% endblock %}

{% block body %}

    <div class="container mt-4">

        <h2>Mes inscriptions</h2>

        {% if inscriptions is empty %}

            <div class="alert alert-info mt-3">
                Vous n'avez aucune inscription.
            </div>

        {% else %}

            <div class="row mt-3">

                {% for inscription in inscriptions %}

                    <div class="col-md-6 mb-3">

                        <div class="card shadow-sm p-3">

                            <h4>
                                {{ inscription.evenement.titre }}
                            </h4>

                            <p>
                                Date de l'événement :
                                {{ inscription.evenement.dateDebut|date('d/m/Y H:i') }}
                            </p>

                            <p>
                                Date d'inscription :
                                {{ inscription.dateInscription|date('d/m/Y H:i') }}
                            </p>

                            <p>
                                Statut :

                                {% if inscription.statut == 'CONFIRME' %}
                                    <span class="badge bg-success">
                                        Confirmé
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger">
                                        Annulé
                                    </span>
                                {% endif %}

                            </p>

                        </div>

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </div>

{% endblock %}
