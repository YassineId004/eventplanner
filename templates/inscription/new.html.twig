
{% extends 'base.html.twig' %}

{% block title %}Inscription à un événement{% endblock %}

{% block body %}

    <div class="container mt-4">

        <h2>Inscription à l'événement</h2>

        <div class="card shadow-sm p-4 mt-3">

            <h4>{{ evenement.titre }}</h4>

            <p>
                Date :
                {{ evenement.dateDebut|date('d/m/Y H:i') }}
            </p>

            <form method="POST">

                <div class="mb-3">
                    <label class="form-label">Nom du participant</label>
                    <input
                        type="text"
                        class="form-control"
                        value="{{ app.user.nom }} {{ app.user.prenom }}"
                        readonly
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label">Email du participant</label>
                    <input
                        type="email"
                        class="form-control"
                        value="{{ app.user.email }}"
                        readonly
                    >
                </div>

                <button type="submit" class="btn btn-primary">
                    S'inscrire
                </button>

            </form>

        </div>

    </div>

{% endblock %}
