
{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

    <div class="container mt-5">

        <h1>Créer un compte</h1>

        {{ form_start(form) }}

            {{ form_row(form.nom) }}

            {{ form_row(form.prenom) }}

            {{ form_row(form.email) }}

        {{ form_row(form.Password) }}
                    <button type="submit" class="btn btn-primary">
                        S'inscrire
                    </button>

                    {{ form_end(form) }}

    </div>

{% endblock %}
